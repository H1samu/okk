# Existing Google Apps Script web app URL from test.html.
HISMAR_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# Private MP4 file in Google Drive. Do not make it public.
